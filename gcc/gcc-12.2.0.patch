diff --git a/gcc/config/rs6000/macmake.h b/gcc/config/rs6000/macmake.h
--- /dev/null
+++ b/gcc/config/rs6000/macmake.h
@@ -0,0 +1,64 @@
+/* macMAKE Classic PPC compiler target based on upstream AIX rs6000 ABI.
+   Copyright (C) 2026 macMAKE contributors.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()             \
+  do                                         \
+    {                                        \
+      builtin_define ("__MACMAKE_CLASSIC_PPC__"); \
+      builtin_define ("__PPC__");          \
+      builtin_define ("__POWERPC__");      \
+      builtin_define ("__powerpc__");      \
+      builtin_assert ("cpu=powerpc");      \
+      builtin_assert ("machine=powerpc");  \
+    }                                        \
+  while (0)
+
+#define TARGET_MACMAKE_CLASSIC 1
+
+/* Register the Classic alignment pragma alongside standard rs6000 handlers. */
+extern void macmake_register_target_pragmas (void);
+#undef REGISTER_TARGET_PRAGMAS
+#define REGISTER_TARGET_PRAGMAS() do { \
+  c_register_pragma (0, "longcall", rs6000_pragma_longcall); \
+  macmake_register_target_pragmas (); \
+  targetm.target_option.pragma_parse = rs6000_pragma_target_parse; \
+  targetm.resolve_overloaded_builtin = altivec_resolve_overloaded_builtin; \
+  rs6000_target_modify_macros_ptr = rs6000_target_modify_macros; \
+} while (0)
+
+/* These candidate mechanics come from GCC's upstream AIX target. */
+#undef DEFAULT_ABI
+#define DEFAULT_ABI ABI_AIX
+#undef TARGET_HAS_TOC
+#define TARGET_HAS_TOC 1
+#undef FIXED_R2
+#define FIXED_R2 1
+#undef STACK_BOUNDARY
+#define STACK_BOUNDARY 128
+
+/* AIX's default field hook word-aligns doubles even in Apple's special
+   PowerPC leading-double structure. The Classic target needs its own
+   field/record policy while leaving the generic AIX target untouched. */
+extern unsigned int macmake_classic_adjust_field_align (tree, tree,
+                                                         unsigned int);
+extern unsigned int macmake_classic_round_type_align (tree, unsigned int,
+                                                       unsigned int);
+#undef ADJUST_FIELD_ALIGN
+#define ADJUST_FIELD_ALIGN(FIELD, TYPE, COMPUTED) \
+  macmake_classic_adjust_field_align (FIELD, TYPE, COMPUTED)
+#undef ROUND_TYPE_ALIGN
+#define ROUND_TYPE_ALIGN(TYPE, COMPUTED, SPECIFIED) \
+  macmake_classic_round_type_align (TYPE, COMPUTED, SPECIFIED)
+
+/* Compiler-only bootstrap must not silently invoke an AIX linker. */
+#undef LINK_SPEC
+#define LINK_SPEC ""
+
+/* AIX shared-library constructor wrappers do not belong to this target. */
+#undef COLLECT_SHARED_INIT_FUNC
+#undef COLLECT_SHARED_FINI_FUNC
+
+/* XCOFF debug records are the bootstrap's native debug transport. */
+#define PREFERRED_DEBUGGING_TYPE XCOFF_DEBUG
