+/* Integer header types for the 32-bit Classic Macintosh target.
+   Copyright (C) 2026 macMAKE contributors.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+/* MSL cstdint and Universal Interfaces CGBase.h use long, rather than
+   int, for the 32-bit types. Equal width does not imply C type identity.
+   Define the complete header handshake here, independently of libc.
+   PTRDIFF_TYPE and SIZE_TYPE remain the rs6000 32-bit compiler types. */
+#define INT8_TYPE "signed char"
+#define UINT8_TYPE "unsigned char"
+#define INT16_TYPE "short int"
+#define UINT16_TYPE "short unsigned int"
+#define INT32_TYPE "long int"
+#define UINT32_TYPE "long unsigned int"
+#define INT64_TYPE "long long int"
+#define UINT64_TYPE "long long unsigned int"
+#define INT_LEAST8_TYPE INT8_TYPE
+#define UINT_LEAST8_TYPE UINT8_TYPE
+#define INT_LEAST16_TYPE INT16_TYPE
+#define UINT_LEAST16_TYPE UINT16_TYPE
+#define INT_LEAST32_TYPE INT32_TYPE
+#define UINT_LEAST32_TYPE UINT32_TYPE
+#define INT_LEAST64_TYPE INT64_TYPE
+#define UINT_LEAST64_TYPE UINT64_TYPE
+#define INT_FAST8_TYPE INT8_TYPE
