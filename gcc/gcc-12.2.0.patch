diff --git a/gcc/config/rs6000/macmake-c.cc b/gcc/config/rs6000/macmake-c.cc
new file mode 100644
--- /dev/null
+++ b/gcc/config/rs6000/macmake-c.cc
@@ -0,0 +1,87 @@
+/* Classic Macintosh PPC pragmas for the macMAKE GCC target.
+   Copyright (C) 2026 macMAKE contributors.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+#define IN_TARGET_CODE 1
+
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "target.h"
+#include "c-family/c-common.h"
+#include "c-family/c-pragma.h"
+#include "stor-layout.h"
+#include "tm_p.h"
+
+struct macmake_field_alignment
+{
+  unsigned int alignment;
+  struct macmake_field_alignment *previous;
+};
+
+static struct macmake_field_alignment *macmake_field_alignment_stack;
+
+static void
+macmake_push_field_alignment (unsigned int alignment)
+{
+  struct macmake_field_alignment *entry = XNEW (struct macmake_field_alignment);
+  entry->alignment = maximum_field_alignment;
+  entry->previous = macmake_field_alignment_stack;
+  macmake_field_alignment_stack = entry;
+  maximum_field_alignment = alignment;
+}
+
+static void
+macmake_pop_field_alignment (void)
+{
+  if (macmake_field_alignment_stack != NULL)
+    {
+      struct macmake_field_alignment *entry = macmake_field_alignment_stack;
+      maximum_field_alignment = entry->alignment;
+      macmake_field_alignment_stack = entry->previous;
+      free (entry);
+    }
+  else
+    error ("too many %<#pragma options align=reset%>");
+}
+
+/* Match GCC Darwin's #pragma options align={mac68k|power|reset} semantics:
+   mac68k caps field alignment at two bytes, power and native select natural
+   target alignment, and reset restores the previous setting.  */
+static void
+macmake_pragma_options (cpp_reader *pfile ATTRIBUTE_UNUSED)
+{
+#define BAD(gmsgid) do { warning (OPT_Wpragmas, gmsgid); return; } while (0)
+  const char *argument;
+  tree token, extra;
+
+  if (pragma_lex (&token) != CPP_NAME)
+    BAD ("malformed %<#pragma options%>, ignoring");
+  argument = IDENTIFIER_POINTER (token);
+  if (strcmp (argument, "align") != 0)
+    BAD ("malformed %<#pragma options%>, ignoring");
+  if (pragma_lex (&token) != CPP_EQ)
+    BAD ("malformed %<#pragma options%>, ignoring");
+  if (pragma_lex (&token) != CPP_NAME)
+    BAD ("malformed %<#pragma options%>, ignoring");
+  if (pragma_lex (&extra) != CPP_EOF)
+    warning (OPT_Wpragmas, "junk at end of %<#pragma options%>");
+
+  argument = IDENTIFIER_POINTER (token);
+  if (strcmp (argument, "mac68k") == 0)
+    macmake_push_field_alignment (16);
+  else if (strcmp (argument, "power") == 0
+           || strcmp (argument, "native") == 0)
+    macmake_push_field_alignment (0);
+  else if (strcmp (argument, "reset") == 0)
+    macmake_pop_field_alignment ();
+  else
+    BAD ("malformed %<#pragma options align={mac68k|power|native|reset}%>, ignoring");
+#undef BAD
+}
+
+void
+macmake_register_target_pragmas (void)
+{
+  c_register_pragma (0, "options", macmake_pragma_options);
+}
diff --git a/gcc/config/rs6000/rs6000.cc b/gcc/config/rs6000/rs6000.cc
--- a/gcc/config/rs6000/rs6000.cc
+++ b/gcc/config/rs6000/rs6000.cc
@@ -8088,9 +8088,99 @@ rs6000_special_round_type_align (tree type, unsigned int computed,
 
   return align;
 }
 
+/* Return the first scalar leaf used by the AIX alignment hooks.  */
+static tree
+macmake_first_embedded_leaf (tree type)
+{
+  while (type != NULL_TREE && TREE_CODE (type) == ARRAY_TYPE)
+    type = TREE_TYPE (type);
+
+  while (type != NULL_TREE && AGGREGATE_TYPE_P (type))
+    {
+      tree field = TYPE_FIELDS (type);
+
+      while (field != NULL_TREE
+             && (TREE_CODE (field) != FIELD_DECL
+                 || DECL_FIELD_ABI_IGNORED (field)))
+        field = DECL_CHAIN (field);
+
+      if (field == NULL_TREE || DECL_PACKED (field))
+        return NULL_TREE;
+
+      type = TREE_TYPE (field);
+      while (type != NULL_TREE && TREE_CODE (type) == ARRAY_TYPE)
+        type = TREE_TYPE (type);
+    }
+
+  return type;
+}
+
+static bool
+macmake_leading_double_record_p (tree type)
+{
+  tree leaf;
+
+  if (type == NULL_TREE || TREE_CODE (type) != RECORD_TYPE
+      || TYPE_PACKED (type))
+    return false;
+
+  leaf = macmake_first_embedded_leaf (type);
+  return (leaf != NULL_TREE && leaf != error_mark_node
+          && !AGGREGATE_TYPE_P (leaf)
+          && (TYPE_MODE (leaf) == DFmode || TYPE_MODE (leaf) == DCmode));
+}
+
+/* Use the Apple Classic PPC leading-double rule for fields in such a
+   record.  AIX otherwise caps each FP double field at word alignment,
+   producing the wrong offset for later doubles.  Keep all other AIX field
+   decisions intact until separately qualified.  */
+unsigned int
+macmake_classic_adjust_field_align (tree field, tree type,
+                                    unsigned int computed)
+{
+  if (TARGET_MACMAKE_CLASSIC && TARGET_ALIGN_NATURAL == 0
+      && field != NULL_TREE && TREE_CODE (field) == FIELD_DECL
+      && type != NULL_TREE && type != error_mark_node
+      && !TYPE_PACKED (type) && !DECL_PACKED (field))
+    {
+      tree context = DECL_CONTEXT (field);
+      tree leaf = macmake_first_embedded_leaf (type);
+
+      if (macmake_leading_double_record_p (context)
+          && leaf != NULL_TREE && leaf != error_mark_node
+          && !AGGREGATE_TYPE_P (leaf)
+          && (TYPE_MODE (leaf) == DFmode || TYPE_MODE (leaf) == DCmode))
+        return computed;
+    }
+
+  return rs6000_special_adjust_field_align (type, computed);
+}
+
+/* In a Classic mac68k pragma scope, maximum_field_alignment already caps
+   member alignment at 16 bits.  Do not let AIX's late record hook override
+   that composite alignment.  The uncapped Power mode retains the AIX record
+   rule, whose 8-byte rounding agrees with Apple's leading-double rule; the
+   field hook above supplies Apple's additional member alignment.  */
+unsigned int
+macmake_classic_round_type_align (tree type, unsigned int computed,
+                                  unsigned int specified)
+{
+  unsigned int align = MAX (computed, specified);
+
+  if (TARGET_MACMAKE_CLASSIC && maximum_field_alignment != 0)
+    return align;
+
+  if ((TREE_CODE (type) == RECORD_TYPE || TREE_CODE (type) == UNION_TYPE
+       || TREE_CODE (type) == QUAL_UNION_TYPE)
+      && TARGET_ALIGN_NATURAL == 0)
+    return rs6000_special_round_type_align (type, computed, specified);
+
+  return align;
+}
+
 /* Darwin increases record alignment to the natural alignment of
    the first field.  */
 
 static unsigned int
 darwin_rs6000_special_round_type_align (tree type, unsigned int computed,
