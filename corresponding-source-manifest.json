      "configure_arguments": [
        "--target=powerpc-unknown-macmake",
        "--enable-languages=c",
        "--disable-bootstrap",
        "--disable-multilib",
        "--disable-libgcc",
        "--disable-libstdcxx",
        "--without-headers"
