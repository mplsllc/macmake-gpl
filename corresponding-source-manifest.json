      "durable_archive_download_url": "https://github.com/mplsllc/macmake-gpl/releases/download/v0.1.0-toolchain-sources/binutils-2.46.1.tar.xz",
      "patch_file": null,
      "patch_sha256": null,
      "build_script": "binutils/build-binutils.sh",
      "configure_arguments": [
