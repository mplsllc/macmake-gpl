    {
      "component_name": "binutils",
      "binary_role": "Classic PowerPC assembler and object inspector (as, objdump)",
      "target_triple": "powerpc-ibm-aix7.1.0.0",
      "upstream_name": "GNU Binutils",
      "upstream_version": "2.46.1",
      "upstream_archive_filename": "binutils-2.46.1.tar.xz",
      "upstream_archive_sha256": "e127a709cba24c76de8936cb7083dd768f28cd37eb010492e2f19b71eb1294e4",
