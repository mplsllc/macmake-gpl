  },
  "components": [
    {
      "component_name": "gcc",
      "binary_role": "Classic PowerPC C/C++ cross-compiler frontend (xgcc / cc1 / cc1plus)",
      "target_triple": "powerpc-unknown-macmake",
      "upstream_name": "GNU Compiler Collection (GCC)",
      "upstream_version": "12.2.0",
      "upstream_archive_filename": "gcc-12.2.0.tar.xz",
